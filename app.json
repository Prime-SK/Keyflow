{
  "expo": {
    "name": "Keyflow",
    "slug": "keyflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/keyflow-icon.png",
    "scheme": "keyflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.primesk.keyflow",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F3",
        "foregroundImage": "./assets/branding/keyflow-icon.png",
        "monochromeImage": "./assets/branding/keyflow-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/keyflow-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "./plugins/with-keyflow-android.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/keyflow-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F3",
          "dark": {
            "backgroundColor": "#F6F7F3"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
